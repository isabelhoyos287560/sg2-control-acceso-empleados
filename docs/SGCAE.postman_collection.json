        {
          "name": "Listar áreas organizacionales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/areas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "areas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status ' + pm.response.code, function () { pm.expect(pm.response.code).to.be.below(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar puntos de acceso (guarda ids)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accesspoints",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accesspoints"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status ' + pm.response.code, function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "const j = pm.response.json(); const enabled = j.data.items.find(a => a.isEnabled); const disabled = j.data.items.find(a => !a.isEnabled); pm.collectionVariables.set('accessPointId', enabled.id); if (disabled) pm.collectionVariables.set('disabledAccessPointId', disabled.id);"
                ]
              }
            }
          ]
        }
      ]
    },
